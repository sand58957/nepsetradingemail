{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000,
      "autoPort": true,
      "cwd": "frontend",
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:8081/api",
        "API_URL": "http://localhost:8081/api/auth"
      }
    },
    {
      "name": "backend",
      "runtimeExecutable": "go",
      "runtimeArgs": ["run", "./cmd/server"],
      "port": 8081,
      "cwd": "backend",
      "env": {
        "PORT": "8081"
      }
    }
  ]
}
